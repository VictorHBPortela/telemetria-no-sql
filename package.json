{
  "name": "telemetria-no-sql",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "seed": "bun src/database/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests eslint.config.ts",
    "test": "bun test --timeout 30000",
    "check": "bun run typecheck && bun run lint && bun test --timeout 30000"
  },
  "dependencies": {
    "@koa/bodyparser": "6.1.0",
    "@koa/router": "15.7.0",
    "koa": "3.2.1",
    "mongoose": "8.24.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.6",
    "@types/koa": "3.0.3",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
